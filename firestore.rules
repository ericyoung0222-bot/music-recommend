rules_version = '2';

// =====================================================================
// Firestore 보안 규칙 (강화판)
// 배포: npx firebase-tools deploy --only firestore:rules
//       또는 Firebase 콘솔 → Firestore Database → 규칙 탭에 전체를 붙여넣고 "게시"
// 아래에 적히지 않은 경로는 모두 거부됩니다.
//
// 클라이언트 코드와 1:1로 맞춰 둔 규칙입니다. js/auth.js, js/playlist.js, js/rating.js에서
// 저장하는 필드를 바꾸면 이 파일도 함께 바꿔야 합니다. (대조표: docs/SECURITY.md)
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공용 검사 함수 ----------

    // 로그인한 본인인지
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 저장하려는 문서
    function incoming() {
      return request.resource.data;
    }

    // 필드가 정확히 이 목록과 같은지 (빠진 필드도, 추가 필드도 없어야 함)
    function hasExactly(fields) {
      return incoming().keys().hasOnly(fields) && incoming().keys().hasAll(fields);
    }

    // 문자열이고 max자 이하인지
    function isText(value, max) {
      return value is string && value.size() <= max;
    }

    // 점수가 1~5 정수인지
    function isScore(value) {
      return value is int && value >= 1 && value <= 5;
    }

    // 서버 시각(serverTimestamp)으로 저장했는지
    function isServerTime(value) {
      return value == request.time;
    }

    // ---------- users/{uid}: 최초 로그인 시 한 번 만들고 본인만 읽음 ----------
    // 클라이언트(js/auth.js ensureUserDoc): setDoc { displayName, photoURL, createdAt: serverTimestamp() }
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && hasExactly(['displayName', 'photoURL', 'createdAt'])
        && isText(incoming().displayName, 200)
        && isText(incoming().photoURL, 200)
        && isServerTime(incoming().createdAt);
      // 사용자 문서는 만든 뒤 수정·삭제하지 않으므로 update와 delete는 허용하지 않음
      // (delete를 허용하면 "지우고 다시 만들기"로 수정 금지를 우회할 수 있음)

      // ---------- 내 플레이리스트 ----------
      // 클라이언트(js/playlist.js):
      //   만들기      addDoc    { name, createdAt: serverTimestamp(), updatedAt: serverTimestamp(), tracks: [] 또는 [곡 1개] }
      //   이름 바꾸기 updateDoc { name, updatedAt: serverTimestamp() }
      //   곡 추가/빼기 transaction.update { tracks, updatedAt: serverTimestamp() }
      //   삭제        deleteDoc
      match /playlists/{playlistId} {
        // 곡 하나의 형식: { key, title, artist, image, url (문자열 200자 이하), addedAt (시각) }
        function isValidTrack(t) {
          return t is map
            && t.keys().hasOnly(['key', 'title', 'artist', 'image', 'url', 'addedAt'])
            && t.keys().hasAll(['key', 'title', 'artist', 'image', 'url', 'addedAt'])
            && isText(t.key, 1500)
            && isText(t.title, 200)
            && isText(t.artist, 200)
            && isText(t.image, 200)
            && isText(t.url, 200)
            && t.addedAt is timestamp;
        }

        // 규칙 언어에는 반복문이 없어서 배열 전체는 검사할 수 없음 → 곡은 항상 맨 뒤에 추가되므로
        // 마지막 곡(새로 들어온 곡)의 형식만 검사 (한계: docs/SECURITY.md)
        function isValidLastTrack(tracks) {
          return tracks.size() == 0 || isValidTrack(tracks[tracks.size() - 1]);
        }

        function isValidPlaylist() {
          return hasExactly(['name', 'createdAt', 'updatedAt', 'tracks'])
            && incoming().name is string
            && incoming().name.size() >= 1
            && incoming().name.size() <= 50
            && incoming().tracks is list
            && incoming().tracks.size() <= 200
            && isValidLastTrack(incoming().tracks)
            && isServerTime(incoming().updatedAt);
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && isValidPlaylist()
          && isServerTime(incoming().createdAt);
        // 수정할 때 만든 시각은 바꿀 수 없음
        allow update: if isOwner(uid)
          && isValidPlaylist()
          && incoming().createdAt == resource.data.createdAt;
      }

      // ---------- 내 평점 ----------
      // 클라이언트(js/rating.js saveRating): batch.set { score, title, artist, image, url, updatedAt: serverTimestamp() }
      // 삭제: batch.delete
      match /ratings/{trackKey} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasExactly(['score', 'title', 'artist', 'image', 'url', 'updatedAt'])
          && isScore(incoming().score)
          && isText(incoming().title, 200)
          && isText(incoming().artist, 200)
          && isText(incoming().image, 200)
          && isText(incoming().url, 200)
          && isServerTime(incoming().updatedAt);
      }
    }

    // ---------- 곡별 평점 (평균 계산용) ----------
    // 읽기는 누구나 (평균/인원 표시). 쓰기·삭제는 문서 ID(uid)가 본인일 때만.
    // 클라이언트(js/rating.js saveRating): batch.set { score, updatedAt: serverTimestamp() }, 삭제: batch.delete
    match /tracks/{trackKey}/ratings/{uid} {
      allow read: if true;
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && hasExactly(['score', 'updatedAt'])
        && isScore(incoming().score)
        && isServerTime(incoming().updatedAt);
    }
  }
}
